generator client {
  provider = "prisma-client-js"
  output   = "./node_modules/@prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model Agent {
  id                 String   @id @default(uuid())
  name               String
  role               String?
  domain             String
  description        String?
  targetAudience     String?
  contentPillars     String?
  voiceAndTone       String?
  editorialWorldview String?
  strongOpinions     String?
  preferredSources   String?
  avoidedTopics      String?
  bannedPhrases      String?
  postStructure      String?
  platformPreferences String?
  isActive           Boolean  @default(true)
  intervalMinutes    Int?     @default(15)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  runs               AgentRun[]
  posts              Post[]
  workflows          Workflow[]
  evaluatedTopics    CandidateTopic[]
}

model AgentRun {
  id               String        @id @default(uuid())
  agent            Agent         @relation(fields: [agentId], references: [id])
  agentId          String
  status           AgentRunStatus
  currentStage     String?
  discoveryMode    String?
  candidatesTotal  Int?          @default(0)
  acceptedCount    Int?          @default(0)
  rejectedCount    Int?          @default(0)
  selectedTopicId  String?
  errorMessage     String?
  retryCount       Int?          @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  durationMs       Int?

  steps            WorkflowRunStep[]
  candidateTopics  CandidateTopic[]
}

model CandidateTopic {
  id               String   @id @default(uuid())
  agent            Agent    @relation(fields: [agentId], references: [id])
  agentId          String
  run              AgentRun? @relation(fields: [runId], references: [id])
  runId            String?
  title            String
  summary          String?
  sourceName       String?
  originalUrl      String?
  canonicalUrl     String?
  publishedAt      DateTime?
  discoveryMode    String
  fingerprint      String?
  relevanceScore   Float?   @default(0)
  noveltyScore     Float?   @default(0)
  sourceTrustScore Float?   @default(0)
  recencyScore     Float?   @default(0)
  depthScore       Float?   @default(0)
  totalScore       Float?   @default(0)
  editorialDecision String?
  rejectionReason  String?
  memorySimilarity Float?   @default(0)
  verificationStatus String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  post             Post?
}

model Post {
  id               String   @id @default(uuid())
  agent            Agent    @relation(fields: [agentId], references: [id])
  agentId          String
  candidate        CandidateTopic? @relation(fields: [candidateId], references: [id])
  candidateId      String? @unique
  title            String?
  body             String
  mainClaims       String?
  sources          String?
  platform         String?
  publishStatus    PublishStatus @default(DRAFT)
  publishMode      String?
  scheduledAt      DateTime?
  publishedAt      DateTime?
  externalId       String?
  failureMessage   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions         PostVersion[]
  metrics          PostMetric[]
  embeddings       Embedding[]
  postVariants     PostVariant[]
}

model WorkflowRunStep {
  id          String   @id @default(uuid())
  run         AgentRun @relation(fields: [runId], references: [id])
  runId       String
  name        String
  status      String
  input       String?
  output      String?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
}

model Workflow {
  id        String         @id @default(uuid())
  agentId   String
  agent     Agent          @relation(fields: [agentId], references: [id])
  name      String
  steps     WorkflowStep[]
  createdAt DateTime       @default(now())
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  stepOrder  Int
  stepType   String
  config     String?
  createdAt  DateTime @default(now())
}

model PostMetric {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}

model Embedding {
  id        String   @id @default(uuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  agentId   String?
  vector    String   // JSON-encoded array of numbers for sqlite dev
  createdAt DateTime @default(now())
}

model PostVersion {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  text      String
  rationale String?
  sources   String?
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(uuid())
  agentId   String
  url       String
  events    String
  createdAt DateTime @default(now())
}

model PostVariant {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  variant   String
  text      String
  createdAt DateTime @default(now())
  metrics   VariantMetric[]
}

model DecisionLog {
  id        String   @id @default(uuid())
  agentId   String
  type      String
  outcome   String?
  payload   String?
  createdAt DateTime @default(now())
}

model SourceCredibility {
  id        String   @id @default(uuid())
  domain    String   @unique
  score     Float    @default(0)
  notes     String?
  checkedAt DateTime @default(now())
}

model VariantMetric {
  id            String     @id @default(uuid())
  postVariantId String
  postVariant   PostVariant @relation(fields: [postVariantId], references: [id])
  impressions   Int        @default(0)
  conversions   Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
