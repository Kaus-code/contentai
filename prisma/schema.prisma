generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Agent {
  id                      String           @id @default(uuid())
  name                    String
  domain                  String
  createdAt               DateTime         @default(now())
  scheduleIntervalMinutes Int?             @default(15)
  schedulePaused          Boolean          @default(false)
  posts                   Post[]
  evaluatedTopics         EvaluatedTopic[]
  workflows               Workflow[]
}

model Post {
  id          String       @id @default(uuid())
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])
  text        String
  rationale   String?
  sources     String?
  createdAt   DateTime     @default(now())
  postMetrics PostMetric[]
}

model EvaluatedTopic {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  title     String
  url       String?
  status    String
  reason    String?
  createdAt DateTime @default(now())
}

model Workflow {
  id        String         @id @default(uuid())
  agentId   String
  agent     Agent          @relation(fields: [agentId], references: [id])
  name      String
  steps     WorkflowStep[]
  createdAt DateTime       @default(now())
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  stepOrder  Int
  stepType   String
  config     String?
  createdAt  DateTime @default(now())
}

model PostMetric {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}

model Embedding {
  id        String   @id @default(uuid())
  postId    String? 
  post      Post?    @relation(fields: [postId], references: [id])
  agentId   String?  
  vector    String   // JSON-encoded array of numbers
  createdAt DateTime @default(now())
}

model DecisionLog {
  id        String   @id @default(uuid())
  agentId   String
  type      String   // e.g., EDITORIAL | NOVELTY | CONTENT
  outcome   String?
  payload   String?  // JSON-encoded details
  createdAt DateTime @default(now())
}

model SourceCredibility {
  id        String   @id @default(uuid())
  domain    String   @unique
  score     Float    @default(0)
  notes     String?
  checkedAt DateTime @default(now())
}
