# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_ai
# Optional direct URL for shadow DBs
DIRECT_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scheduler and Security
CRON_SECRET=change-me
ADMIN_API_KEY=change-me

# Discovery and Publishing
DISCOVERY_MODE=LIVE
PUBLISHING_MODE=MOCK
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: pgvector URL for vector DB (postgres instance)
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5432/autonomous_ai
