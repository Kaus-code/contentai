{
  "name": "autonomous-ai-creator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:discovery": "node scripts/run-discovery.cjs",
    "test:integration": "node scripts/test-integration.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:dev": "prisma generate --schema=prisma/schema.dev.prisma",
    "prisma:migrate": "prisma migrate dev --name init",
    "migrate:dev": "prisma migrate dev",
    "migrate:dev:sqlite": "prisma migrate dev --schema=prisma/schema.dev.prisma --name init",
    "migrate:deploy": "prisma migrate deploy",
    "db:up": "docker-compose up -d db",
    "one-cycle": "ts-node scripts/run-experiments.ts",
    "one-cycle:compiled": "npx tsc -p tsconfig.build.json && node dist/scripts/run-cycle.js",
    "force-publish": "node scripts/force-publish.js",
    "seed": "ts-node prisma/seed.ts",
    "seed:dev": "psql file:./prisma/manual_seed.sql || node -e \"console.log('Run manual seed against sqlite using sqlite3 CLI or prisma client')\"",
    "run:experiments": "ts-node scripts/run-experiments.ts",
    "test:all": "node scripts/tests/editorial.test.fallback.js && node scripts/tests/content.test.fallback.js",
    "promote-drafts": "node scripts/promote-drafts.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^14.0.0",
    "openai": "^4.9.0",
    "pg": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
